# ─────────────────────────────────────────────────────────────────────────────
#  College Student Management System — environment template
#  Copy this file to .env and fill in your values.
#  The .env file is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Flask
# Generate a real key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── Local development (Python directly, NOT Docker) ───────────────────────────
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_mysql_root_password
# DB_NAME=student_management

# ── Docker Compose ────────────────────────────────────────────────────────────
# These values are used by both the db service and the web service.
# DB_HOST is set automatically to "db" inside docker-compose.yml.
DB_HOST=db
DB_PORT=3306
DB_NAME=student_management
DB_USER=sms_user
DB_PASSWORD=sms_password
DB_ROOT_PASSWORD=rootpassword

# Flask environment (development | production)
FLASK_ENV=production
